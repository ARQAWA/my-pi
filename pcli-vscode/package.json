{
  "name": "pcli",
  "displayName": "ARQAWA PCLI",
  "version": "0.0.8",
  "publisher": "arqawa",
  "repository": {
    "type": "git",
    "url": "https://github.com/ARQAWA/my-pi.git"
  },
  "engines": {
    "vscode": "^1.86.0"
  },
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      { "command": "pcli.newTab", "title": "New Tab", "category": "Pi CLI" },
      { "command": "pcli.update", "title": "Update", "category": "Pi CLI" }
    ],
    "keybindings": [
      {
        "key": "ctrl+enter",
        "command": "workbench.action.terminal.sendSequence",
        "when": "terminalFocus && pcli.terminalActive",
        "args": { "text": "\u001b[13;5u" }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "node fetch-pi.mjs && node bundle-my-pi.mjs"
  },
  "devDependencies": {
    "@vscode/test-electron": "^3.1.0"
  }
}
