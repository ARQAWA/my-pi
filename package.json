{
  "name": "my-pi",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test --experimental-test-isolation=none \"test/extensions/*/*.test.ts\" \"test/*.test.ts\"",
    "lint": "oxlint --config .oxlintrc.json extensions test .pi",
    "knip": "knip --config knip.config.mjs --cache --no-progress --reporter compact --max-show-issues 20",
    "check": "node scripts/check.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty false",
    "qa-status": "node scripts/qa-status.mjs",
    "ci-watch": "node scripts/ci-watch.mjs"
  },
  "keywords": [
    "pi-package"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/RQW-settings/index.ts",
      "./extensions/RQW-prompt/index.ts",
      "./extensions/RQW-tools/index.ts",
      "./extensions/RQW-context/index.ts",
      "./extensions/RQW-agent/index.ts",
      "./extensions/RQW-review/index.ts",
      "./extensions/RQW-statusbar/index.ts",
      "./extensions/RQW-models/index.ts",
      "./extensions/RQW-anthropic/index.ts",
      "./extensions/RQW-scroll/index.ts",
      "./extensions/RQW-session/index.ts",
      "./extensions/RQW-send-now/index.ts",
      "./extensions/RQW-mouse/index.ts",
      "./extensions/RQW-providers/index.ts",
      "./extensions/RQW-codex/index.ts",
      "./extensions/RQW-web/index.ts",
      "./extensions/RQW-naming/index.ts",
      "./extensions/RQW-agent-ui/index.ts",
      "./extensions/RQW-tool-ui/index.ts",
      "./extensions/RQW-blocks/index.ts",
      "./extensions/RQW-skill-dollar/index.ts",
      "./extensions/RQW-history-edit/index.ts",
      "./extensions/RQW-dyslexia/index.ts",
      "./extensions/RQW-live-tail/index.ts",
      "./extensions/RQW-codex-compat/index.ts",
      "./extensions/RQW-tabs-link/index.ts",
      "./extensions/RQW-btw/index.ts"
    ],
    "themes": [
      "./extensions/RQW-theme/theme.json"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "knip": "6.43.0",
    "oxlint": "1.89.0",
    "typebox": "1.3.27",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "smol-toml": "1.9.1",
    "ws": "8.22.0"
  }
}
